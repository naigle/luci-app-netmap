#!/bin/sh /etc/rc.common
# /etc/init.d/netmap
# procd-based service: runs an initial scan on start,
# then sets up cron for periodic background scans.

START=95
STOP=05
USE_PROCD=1

SCAN_BIN="/usr/bin/netmap-scan"
CRON_QUICK="*/5 * * * * $SCAN_BIN quick >/dev/null 2>&1"
CRON_DEEP="*/30 * * * * $SCAN_BIN deep >/dev/null 2>&1"
CRON_TAG="netmap-scan"

start_service() {
    # Immediately run a quick scan in the background
    "$SCAN_BIN" quick >/dev/null 2>&1 &

    # Register a dummy procd instance so the service shows as running
    procd_open_instance
    procd_set_param command /bin/sh -c "while true; do sleep 3600; done"
    procd_set_param respawn
    procd_close_instance

    # Install cron jobs (idempotent)
    _install_cron
}

stop_service() {
    _remove_cron
}

_install_cron() {
    # Remove any stale entries first, then add fresh ones
    local tmp
    tmp=$(crontab -l 2>/dev/null | grep -v "$CRON_TAG")
    printf '%s\n%s # %s\n%s # %s\n' \
        "$tmp" \
        "$CRON_QUICK" "$CRON_TAG" \
        "$CRON_DEEP"  "$CRON_TAG" \
        | crontab -
    /etc/init.d/cron reload 2>/dev/null || true
}

_remove_cron() {
    crontab -l 2>/dev/null | grep -v "$CRON_TAG" | crontab -
    /etc/init.d/cron reload 2>/dev/null || true
}

reload_service() {
    "$SCAN_BIN" quick >/dev/null 2>&1 &
}
