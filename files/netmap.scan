#!/bin/sh
# /usr/bin/netmap-scan
# Network device scanner for OpenWrt luci-app-netmap
# Usage: netmap-scan [quick|deep]

NETMAP_DIR="/etc/netmap"
DEVICES_FILE="$NETMAP_DIR/devices.json"
OUI_DB="/usr/share/netmap/oui.db"
ASSEMBLE="/usr/share/netmap/assemble.uc"
LOCK_FILE="/tmp/netmap_scan.lock"
TMP_DIR="/tmp/netmap_$$"
SCAN_MODE="${1:-quick}"

# ---- Lock ----
if [ -f "$LOCK_FILE" ]; then
    pid=$(cat "$LOCK_FILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        logger -t netmap "Already running (PID $pid)"
        exit 1
    fi
fi
printf '%s' "$$" > "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"; rm -rf "$TMP_DIR"' EXIT INT TERM

mkdir -p "$NETMAP_DIR" "$TMP_DIR"

log() { logger -t netmap "$*"; }
NOW=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

# ============================================================
# STEP 1 – Network topology
# ============================================================
log "[$SCAN_MODE] Step 1: network info"

LOCAL_IP=$(ip addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | head -1)
[ -z "$LOCAL_IP" ] && LOCAL_IP=$(ip route get 1.1.1.1 2>/dev/null | awk '/src/{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1)

SCAN_NET=$(ip route | awk '/br-lan/{print $1}' | grep -v default | head -1)
[ -z "$SCAN_NET" ] && SCAN_NET="$(printf '%s' "$LOCAL_IP" | cut -d. -f1-3).0/24"

# Collect this router's own MACs (to exclude from device list)
ROUTER_MACS=$(ip link show 2>/dev/null | awk '/link\/ether/{gsub(/:/,"",$2); print toupper($2)}' | tr '\n' ' ')

log "  LAN IP=$LOCAL_IP  Network=$SCAN_NET"

# ============================================================
# STEP 2 – Wireless interfaces + station dumps
# ============================================================
log "[$SCAN_MODE] Step 2: wireless stations"

> "$TMP_DIR/wifi_ifaces.txt"
> "$TMP_DIR/wifi_stations.txt"
> "$TMP_DIR/wifi_survey.txt"

for iface in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
    ip link show "$iface" 2>/dev/null | grep -q 'state UP' || continue

    ssid=$(iwinfo "$iface" info 2>/dev/null | awk -F'"' '/ESSID/{print $2}')
    chan=$(iwinfo "$iface" info 2>/dev/null | grep -oE 'Channel: [0-9]+' | awk -F': ' '{print $2}')
    freq=$(iwinfo "$iface" info 2>/dev/null | grep -oE '[0-9]+\.[0-9]+ GHz' | head -1)

    band="2.4GHz"
    case "$freq" in 6.*) band="6GHz" ;; 5.*) band="5GHz" ;; esac
    [ -z "$chan" ] && chan="0"

    printf '%s\t%s\t%s\t%s\n' "$iface" "$ssid" "$band" "$chan" >> "$TMP_DIR/wifi_ifaces.txt"
    log "  $iface  SSID='$ssid'  $band  ch$chan"

    # Parse station dump block-by-block
    cur_mac="" cur_sig="" cur_tx="" cur_rx="" cur_fail="" cur_retry="" cur_inactive=""
    while IFS= read -r line; do
        case "$line" in
            Station*)
                if [ -n "$cur_mac" ]; then
                    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                        "$(printf '%s' "$cur_mac" | tr '[:upper:]' '[:lower:]')" \
                        "$iface" "$cur_sig" "$cur_tx" "$cur_rx" \
                        "$cur_fail" "$cur_retry" "$cur_inactive" \
                        >> "$TMP_DIR/wifi_stations.txt"
                fi
                cur_mac=$(printf '%s' "$line" | awk '{print $2}')
                cur_sig="" cur_tx="" cur_rx="" cur_fail="" cur_retry="" cur_inactive=""
                ;;
            *signal:*)
                cur_sig=$(printf '%s' "$line" | grep -oE '[-0-9]+' | head -1) ;;
            *tx\ bitrate:*)
                cur_tx=$(printf '%s' "$line" | grep -oE '[0-9]+\.[0-9]+' | head -1) ;;
            *rx\ bitrate:*)
                cur_rx=$(printf '%s' "$line" | grep -oE '[0-9]+\.[0-9]+' | head -1) ;;
            *tx\ failed:*)
                cur_fail=$(printf '%s' "$line" | grep -oE '[0-9]+' | head -1) ;;
            *tx\ retries:*)
                cur_retry=$(printf '%s' "$line" | grep -oE '[0-9]+' | head -1) ;;
            *inactive\ time:*)
                cur_inactive=$(printf '%s' "$line" | grep -oE '[0-9]+' | head -1) ;;
        esac
    done << STATIONEOF
$(iw dev "$iface" station dump 2>/dev/null)
STATIONEOF

    if [ -n "$cur_mac" ]; then
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$(printf '%s' "$cur_mac" | tr '[:upper:]' '[:lower:]')" \
            "$iface" "$cur_sig" "$cur_tx" "$cur_rx" \
            "$cur_fail" "$cur_retry" "$cur_inactive" \
            >> "$TMP_DIR/wifi_stations.txt"
    fi

    # Parse survey dump — collect stats for the [in use] frequency only
    _noise="" _active="" _busy="" _tx="" _rx="" _in_use=0
    while IFS= read -r sline; do
        case "$sline" in
            *frequency:*"[in use]"*) _in_use=1 ;;
            *frequency:*)            _in_use=0 ;;
            *noise:*)                [ "$_in_use" = 1 ] && _noise=$(printf '%s' "$sline"   | grep -oE '[-0-9]+' | head -1) ;;
            *"channel active time:"*)   [ "$_in_use" = 1 ] && _active=$(printf '%s' "$sline" | grep -oE '[0-9]+' | head -1) ;;
            *"channel busy time:"*)     [ "$_in_use" = 1 ] && _busy=$(printf '%s' "$sline"   | grep -oE '[0-9]+' | head -1) ;;
            *"channel receive time:"*)  [ "$_in_use" = 1 ] && _rx=$(printf '%s' "$sline"     | grep -oE '[0-9]+' | head -1) ;;
            *"channel transmit time:"*) [ "$_in_use" = 1 ] && _tx=$(printf '%s' "$sline"     | grep -oE '[0-9]+' | head -1) ;;
        esac
    done << SURVEYEOF
$(iw dev "$iface" survey dump 2>/dev/null)
SURVEYEOF
    _busy_pct="" _tx_pct="" _rx_pct=""
    if [ -n "$_active" ] && [ "$_active" -gt 0 ] 2>/dev/null; then
        _busy_pct=$(( ${_busy:-0} * 100 / _active ))
        _tx_pct=$(( ${_tx:-0}   * 100 / _active ))
        _rx_pct=$(( ${_rx:-0}   * 100 / _active ))
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$iface" "$_noise" "$_busy_pct" "$_tx_pct" "$_rx_pct" \
        >> "$TMP_DIR/wifi_survey.txt"
done

log "  Stations: $(wc -l < "$TMP_DIR/wifi_stations.txt")"

# ============================================================
# STEP 3 – DHCP leases
# ============================================================
log "[$SCAN_MODE] Step 3: DHCP leases"
> "$TMP_DIR/dhcp.txt"
if [ -f /tmp/dhcp.leases ]; then
    while read -r _epoch mac ip hostname _rest; do
        [ "$hostname" = "*" ] && hostname=""
        printf '%s\t%s\t%s\n' \
            "$(printf '%s' "$mac" | tr '[:upper:]' '[:lower:]')" \
            "$ip" "$hostname" >> "$TMP_DIR/dhcp.txt"
    done < /tmp/dhcp.leases
fi
log "  DHCP: $(wc -l < "$TMP_DIR/dhcp.txt") leases"

# ============================================================
# STEP 4 – ARP table (with nmap ping sweep to populate cache)
# ============================================================
log "[$SCAN_MODE] Step 4: ARP sweep"
> "$TMP_DIR/arp.txt"

flush_arp() {
    # ip neigh format: IP dev IFACE lladdr MAC STATE
    # awk filters to entries with a resolved MAC (lladdr present)
    ip neigh show 2>/dev/null | awk -v router="$LOCAL_IP" '
        / lladdr / && $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $1 != router &&
        ($NF == "REACHABLE" || $NF == "STALE" || $NF == "DELAY" || $NF == "PROBE" || $NF == "PERMANENT" || $NF == "NOARP") {
            print $1 "\t" tolower($5)
        }
    ' >> "$TMP_DIR/arp.txt"
}

flush_arp
nmap -sn -T4 --host-timeout 3s --exclude "$LOCAL_IP" "$SCAN_NET" >/dev/null 2>&1
flush_arp
sort -u -o "$TMP_DIR/arp.txt" "$TMP_DIR/arp.txt"
log "  ARP: $(wc -l < "$TMP_DIR/arp.txt") entries"

# ============================================================
# STEP 5 – nmap OS fingerprinting (deep mode only)
# ============================================================
> "$TMP_DIR/nmap_os.txt"
if [ "$SCAN_MODE" = "deep" ]; then
    log "[$SCAN_MODE] Step 5: nmap OS fingerprinting"
    nmap -O --osscan-guess -sV --version-light -T4 \
        --host-timeout 30s --exclude "$LOCAL_IP" "$SCAN_NET" \
        -oG "$TMP_DIR/nmap_deep.gnmap" >/dev/null 2>&1

    # Extract: IP <TAB> OS string
    grep '^Host:' "$TMP_DIR/nmap_deep.gnmap" 2>/dev/null | \
        sed -n 's/.*Host: \([0-9.]*\) .*OS: \([^|]*\).*/\1\t\2/p' | \
        sed 's/[[:space:]]*$//' \
        > "$TMP_DIR/nmap_os.txt"

    log "  nmap OS: $(wc -l < "$TMP_DIR/nmap_os.txt") results"
fi

# ============================================================
# STEP 6 – System health metrics
# ============================================================
log "[$SCAN_MODE] Step 6: system health"
NPROC=$(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)
LOAD1=$(awk '{print $1}' /proc/loadavg)
LOAD_PCT=$(awk -v l="$LOAD1" -v c="$NPROC" 'BEGIN{p=l/c*100; if(p>100)p=100; printf "%d",p}')
MEM_TOTAL=$(awk '/MemTotal/{print $2}' /proc/meminfo)
MEM_FREE=$(awk '/MemFree/{print $2}' /proc/meminfo)
MEM_BUFS=$(awk '/Buffers/{print $2}' /proc/meminfo)
MEM_CACHED=$(awk '/^Cached:/{print $2}' /proc/meminfo)
MEM_PCT=$(awk -v t="$MEM_TOTAL" -v f="$MEM_FREE" -v b="$MEM_BUFS" -v c="$MEM_CACHED" \
    'BEGIN{printf "%d", (t-f-b-c)*100/t}')
UPTIME_S=$(awk '{printf "%d", $1}' /proc/uptime)
WAN_MS=$(ping -c 1 -W 2 8.8.8.8 2>/dev/null | awk -F'/' '/rtt|round-trip/{printf "%d", $5}')
printf '%s\t%s\t%s\t%s\n' "$LOAD_PCT" "$MEM_PCT" "$UPTIME_S" "${WAN_MS}" > "$TMP_DIR/health.txt"
log "  load=${LOAD_PCT}% mem=${MEM_PCT}% uptime=${UPTIME_S}s wan=${WAN_MS:-?}ms"

# ============================================================
# STEP 7 – Ping latency (parallel, one ping per host)
# ============================================================
log "[$SCAN_MODE] Step 7: ping latency"
> "$TMP_DIR/latency.txt"
while IFS='	' read -r ip _mac; do
    (
        ms=$(ping -c 1 -W 1 "$ip" 2>/dev/null \
            | awk -F'/' '/rtt|round-trip/{printf "%d", $5}')
        [ -n "$ms" ] && printf '%s\t%s\n' "$ip" "$ms" >> "$TMP_DIR/latency.txt"
    ) &
done < "$TMP_DIR/arp.txt"
wait
log "  Latency: $(wc -l < "$TMP_DIR/latency.txt") hosts"

# ============================================================
# STEP 8 – Preserve history from existing data
# ============================================================
> "$TMP_DIR/existing.txt"
if [ -f "$DEVICES_FILE" ]; then
    # Use ucode to extract: mac TAB first_seen TAB custom_name TAB custom_type
    ucode -e '
import { open } from "fs";
let f = open(ARGV[0], "r");
if (f) {
    let d;
    try { d = json(f.read("all")); } catch(e) {}
    f.close();
    for (let _i, dev in (d?.devices ?? [])) {
        print(dev.mac + "\t" + (dev.first_seen ?? "") + "\t" + (dev.custom_name ?? "") + "\t" + (dev.custom_type ?? "") + "\n");
    }
}
' "$DEVICES_FILE" > "$TMP_DIR/existing.txt" 2>/dev/null || true
fi

# ============================================================
# STEP 9 – Assemble JSON via ucode
# ============================================================
log "[$SCAN_MODE] Step 9: assembling JSON"

ucode "$ASSEMBLE" \
    "$TMP_DIR/arp.txt" \
    "$TMP_DIR/dhcp.txt" \
    "$TMP_DIR/wifi_stations.txt" \
    "$TMP_DIR/wifi_ifaces.txt" \
    "$TMP_DIR/nmap_os.txt" \
    "$TMP_DIR/existing.txt" \
    "$OUI_DB" \
    "$SCAN_NET" \
    "$LOCAL_IP" \
    "$SCAN_MODE" \
    "$NOW" \
    "$DEVICES_FILE" \
    "$ROUTER_MACS" \
    "$TMP_DIR/latency.txt" \
    "$TMP_DIR/wifi_survey.txt" \
    "$TMP_DIR/health.txt"

log "[$SCAN_MODE] Scan complete"
exit 0
