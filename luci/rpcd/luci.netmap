// /usr/share/rpcd/ucode/luci.netmap
// ucode rpcd handler for the Network Map dashboard

'use strict';

import { access, open } from 'fs';
import { cursor } from 'uci';

const DEVICES_FILE = '/etc/netmap/devices.json';
const SCAN_BIN     = '/usr/bin/netmap-scan';
const LOCK_FILE    = '/tmp/netmap_scan.lock';

function readDevices() {
	const f = open(DEVICES_FILE, 'r');
	if (!f)
		return {
			meta: { last_scan: null, device_count: 0, scan_mode: 'none' },
			interfaces: [{ name: 'wired', type: 'wired', display: 'Wired (Ethernet)', ssid: '', band: '', channel: 0 }],
			devices: []
		};

	let data;
	try {
		data = json(f.read('all'));
	} catch(e) {
		data = {};
	}
	f.close();
	return data || {};
}

const methods = {
	// Return the full device dataset
	get_devices: {
		call: function(req) {
			return readDevices();
		}
	},

	// Return lightweight status (scanning flag + counts)
	get_status: {
		call: function(req) {
			const scanning = access(LOCK_FILE) ? true : false;
			const data     = readDevices();
			return {
				scanning,
				last_scan:    data?.meta?.last_scan    ?? null,
				scan_mode:    data?.meta?.scan_mode    ?? null,
				device_count: data?.meta?.device_count ?? 0,
			};
		}
	},

	// Set custom name and/or type for a device; persists in devices.json
	// and syncs a static DHCP lease (mac+ip+name) to /etc/config/dhcp
	set_device_name: {
		args: { mac: 'xx:xx:xx:xx:xx:xx', name: '', type: '' },
		call: function(req) {
			const mac  = lc(trim(req.args?.mac ?? ''));
			const name = trim(req.args?.name ?? '');
			const type = trim(req.args?.type ?? '');
			if (!mac) return { error: 'missing mac' };

			// Update custom_name and custom_type in devices.json
			const data = readDevices();
			let found = false;
			let devIP  = '';
			for (let _i, dev in (data.devices ?? [])) {
				if (lc(dev.mac) === mac) {
					devIP = dev.ip ?? '';
					dev.custom_name = name;
					if (length(type)) {
						dev.custom_type  = type;
						dev.device_type  = type;
					} else {
						dev.custom_type  = '';
					}
					found = true;
					break;
				}
			}
			if (!found) return { error: 'device not found' };

			const tmp = DEVICES_FILE + '.tmp';
			const wf  = open(tmp, 'w');
			if (wf) { wf.write(sprintf('%J', data)); wf.close(); }
			system([ 'mv', tmp, DEVICES_FILE ]);

			// Sync static DHCP lease — only when we have both a name and an IP
			const uci = cursor();
			uci.load('dhcp');

			let sect = null;
			uci.foreach('dhcp', 'host', function(s) {
				if (lc(s.mac ?? '') === mac) { sect = s['.name']; return false; }
			});

			if (name && devIP) {
				if (!sect) sect = uci.add('dhcp', 'host');
				uci.set('dhcp', sect, 'mac',  mac);
				uci.set('dhcp', sect, 'ip',   devIP);
				uci.set('dhcp', sect, 'name', name);
			} else if (!name && sect) {
				uci.delete('dhcp', sect);
			}

			uci.commit('dhcp');
			system([ '/bin/sh', '-c', '(sleep 2 && /etc/init.d/dnsmasq reload) >/dev/null 2>&1 &' ]);

			return { ok: true, mac, name, type };
		}
	},

	// Trigger a background scan (quick or deep)
	trigger_scan: {
		args: { mode: 'quick' },
		call: function(req) {
			if (access(LOCK_FILE))
				return { status: 'busy' };

			const mode = (req.args?.mode === 'deep') ? 'deep' : 'quick';
			system([ '/bin/sh', '-c', `${SCAN_BIN} ${mode} >/tmp/netmap_last.log 2>&1 &` ]);
			return { status: 'started', mode };
		}
	}
};

return { 'luci.netmap': methods };
